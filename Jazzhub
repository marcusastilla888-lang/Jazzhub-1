})

-- Configuration & State Settings
local Config = {
    AutoFarm = false,
    FastAttack = false,
    SelectedWeapon = "Melee",
    SelectedStat = "Melee",
    AutoStats = false
}

-- Helper Function to Safely Invoke Blox Fruits Remotes (CommF_)
local function RemoteInvoke(...)
    local args = {...}
    local success, err = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(args))
    end)
    return success and err
end

